{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "moduleNameMapper": {
    "^@mikro-orm/core$": "<rootDir>/mocks/mikro-orm-core.mock.ts",
    "^@mikro-orm/decorators/legacy$": "<rootDir>/mocks/mikro-orm-decorators.mock.ts",
    "^@mikro-orm/nestjs$": "<rootDir>/mocks/mikro-orm-nestjs.mock.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  }
}
