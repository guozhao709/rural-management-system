NODE_ENV=development
PORT=3000

# Local Docker Compose database
DATABASE_URL=postgresql://zhixiang:zhixiang_dev_password@localhost:5433/zhixiang_v2

# Authentication secrets must differ and each contain at least 32 characters.
JWT_ACCESS_SECRET=replace-with-an-independent-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-an-independent-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional one-time super-admin seed input. Do not commit real values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional OpenAI-compatible LLM provider. Empty values do not block startup.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Agriculture analysis. The service reports unavailable capability when required
# external configuration is missing; it must not fabricate results.
AGRICULTURE_ANALYSIS_ENABLED=true
AGRICULTURE_ANALYSIS_DAILY_LIMIT=10
AGRICULTURE_KNOWLEDGE_LIMIT=8

# Resident health. Assessment and AI explanation are disabled by default.
HEALTH_ASSESSMENT_ENABLED=false
HEALTH_AI_EXPLANATION_ENABLED=false
HEALTH_ASSESSMENT_DAILY_LIMIT=5
HEALTH_KNOWLEDGE_LIMIT=6
HEALTH_DATA_RETENTION_DAYS=365
HEALTH_RULESET_VERSION=
HEALTH_DATA_ENCRYPTION_KEY=
HEALTH_LEGACY_ROUTES_ENABLED=false

# Comma-separated origins. Wildcards are intentionally not supported.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info
