# Copy this file to .env and replace every placeholder locally.
# Never commit .env, API keys, passwords, or JWT secrets.

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
# This is a local development example, not a production credential.
DATABASE_URL=postgresql://zhixiang:replace-with-local-db-password@localhost:5433/zhixiang_v2

# Authentication
# Use two different random strings of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional one-time super-admin seed input.
# Leave blank unless you deliberately run the seed command.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI-compatible model provider
# Health and agriculture analyses share this provider configuration.
# Leave all three values blank to start the server without live AI analysis.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Agriculture analysis limits
AGRICULTURE_ANALYSIS_ENABLED=true
AGRICULTURE_ANALYSIS_DAILY_LIMIT=10
AGRICULTURE_KNOWLEDGE_LIMIT=8

# Browser origins allowed to call the API. Do not use *.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
