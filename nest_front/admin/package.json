{
  "name": "zhixiang-cloud-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "dev:e2e": "vite --host 127.0.0.1 --port 6173 --strictPort"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "3.0.4",
    "vue": "^3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.3.11",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "vitest": "5.0.0"
  }
}
